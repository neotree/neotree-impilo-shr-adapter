# Source Identification
SOURCE_ID=neotree-system
# FACILITY_ID is automatically generated from decrypted impilo_id (ZW + first 2 segments before 3rd dash)
# Example: impilo_id "00-0D-0D-2026-N-00001" → FACILITY_ID "ZW000D0D"
# FACILITY_NAME is optional and used for logging/documentation only
FACILITY_NAME=Sally Mugabe Central Hospital

# Database Configuration (for CDC polling)
# RECOMMENDED: Use ~/.pgpass file instead of DB_PASSWORD for security
# Format: hostname:port:database:username:password
# Set permissions: chmod 600 ~/.pgpass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neotree
DB_USER=postgres
# DB_PASSWORD=  # Leave empty if using .pgpass (recommended)
DB_SSL=false
DB_SOURCE_TABLE=sessions
# CDC watermark starting date (format: YYYY-MM-DD HH:MM:SS)
# Records ingested after this date will be processed
DB_WATERMARK_START=1970-01-01 00:00:00

# OpenHIM Configuration
OPENHIM_BASE_URL=http://localhost:5001
OPENHIM_USERNAME=admin@openhim.org
OPENHIM_PASSWORD=your_openhim_password
OPENHIM_CHANNEL_PATH=/fhir
OPENHIM_CLIENT_ID=

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
ADAPTER_PORT=3001

# Security
# ENCRYPTION_KEY: Used for sync/retry workflow encryption (for FHIR adapter internal use)
ENCRYPTION_KEY=your-32-character-encryption-key
# IMPILO_ENCRYPTION_SECRET: Used for decrypting impilo_id and data columns from DB_SOURCE_TABLE
# This is the encryption secret from the Impilo system that encrypted the data at source
IMPILO_ENCRYPTION_SECRET=your-32-character-impilo-secret

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
#TESTING
TEST_NODE_API=http://localhost:4000
